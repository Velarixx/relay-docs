# Copy to .env next to docker-compose.yml and fill in. Never commit the filled-in file.

# The public name of your Relay; Caddy gets a TLS certificate for it. "localhost" works for a trial.
RELAY_DOMAIN=chat.example.com
# The Relay version to run. Change the tag to upgrade.
RELAY_IMAGE=ghcr.io/velarixx/relay:0.2.0

# change me: long random values, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=
POSTGRES_PASSWORD=

# Outgoing mail (invites, password resets, notifications), e.g. smtp://user:pass@smtp.example.com:587
SMTP_URL=
MAIL_FROM=Relay <relay@example.com>

# Optional: keeps /metrics private (Prometheus sends it as a bearer token).
METRICS_TOKEN=

# Optional: voice and video. To run LiveKit here too, start with `docker compose --profile calls up -d`,
# point a second name (LIVEKIT_DOMAIN) at this machine, open ports 7881/tcp and 7882/udp, and set:
#   LIVEKIT_DOMAIN=rtc.example.com
#   LIVEKIT_URL=wss://rtc.example.com
#   LIVEKIT_API_URL=http://livekit:7880
#   LIVEKIT_API_KEY=relay
#   LIVEKIT_API_SECRET=<a long random value, at least 32 characters>
# Sound and picture use ports 7881/tcp and 7882/udp; LIVEKIT_TCP_PORT and LIVEKIT_UDP_PORT change them.
# For a LiveKit server elsewhere, set only LIVEKIT_URL and its key and secret.
LIVEKIT_DOMAIN=
LIVEKIT_URL=
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=


# Optional: the vendor's push gateway, for notifications in the mobile apps while they are
# closed. Without it Relay works in full, without those notifications.
PUSH_GATEWAY_URL=

# Optional: where `docker compose run --rm backup` writes backups (default ./backups).
BACKUP_DIR=
# Optional: other ports for Caddy, when 80 and 443 are taken (certificates then need DNS).
HTTP_PORT=
HTTPS_PORT=

# Every other Relay setting (S3 storage, a read replica, OpenSearch, your own extensions...)
# goes in a file relay.env next to docker-compose.yml, one NAME=value per line.
