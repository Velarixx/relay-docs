# Copy to .env next to docker-compose.yml and fill in. Never commit the filled-in file.

# The public name of your Relay; Caddy gets a TLS certificate for it. "localhost" works for a trial.
RELAY_DOMAIN=chat.example.com
# The Relay version to run. Change the tag to upgrade.
RELAY_IMAGE=ghcr.io/velarixx/relay:0.2.0

# change me: long random values, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=
POSTGRES_PASSWORD=

# Outgoing mail (invites, password resets, notifications), e.g. smtp://user:pass@smtp.example.com:587
SMTP_URL=
MAIL_FROM=Relay <relay@example.com>

# Optional: keeps /metrics private (Prometheus sends it as a bearer token).
METRICS_TOKEN=

# Optional: voice and video through your LiveKit server.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: where this Relay checks in with its subscription. Leave empty to use the built-in address.
LICENSE_SERVER_URL=

# Optional: the vendor's push gateway, for notifications in the mobile apps while they are
# closed. Without it Relay works in full, without those notifications.
PUSH_GATEWAY_URL=
